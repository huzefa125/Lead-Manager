# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit .env.
# Generate strong secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_db?schema=public"

# JWT — the two secrets MUST be different from each other
JWT_ACCESS_SECRET="replace-me-with-a-long-random-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="replace-me-with-a-long-random-refresh-secret-at-least-32-chars"
JWT_ISSUER=auth-service
JWT_AUDIENCE=auth-service-clients
# Access token: short-lived, verified in memory, never stored server-side.
ACCESS_TOKEN_TTL=15m
# Refresh token: long-lived, stored (hashed) in Postgres, delivered via httpOnly cookie.
REFRESH_TOKEN_TTL_DAYS=7

# Password hashing
BCRYPT_SALT_ROUNDS=12

# HTTP
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
COOKIE_DOMAIN=
REFRESH_COOKIE_NAME=refresh_token

# Swagger UI at /api/docs. Consider "false" in production — the spec maps every
# endpoint and its validation rules.
ENABLE_API_DOCS=true

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
