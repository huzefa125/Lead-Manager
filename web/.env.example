# Copy to .env.local for local overrides. Neither file is required — the
# defaults work against the API running on its usual port.

# Where `npm run dev` proxies /api. Change this if the API is not on :4000.
VITE_API_PROXY_TARGET=http://localhost:4000

# Where the browser sends API calls. Defaults to the same-origin "/api", which
# is what the dev proxy serves and what a reverse proxy would serve in
# production. Set an absolute URL only when the API is on another origin — the
# refresh cookie then needs SameSite=None and a matching CORS_ORIGINS entry on
# the server.
# VITE_API_BASE_URL=https://api.example.com/api
